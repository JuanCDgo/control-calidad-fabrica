# Entornos virtuales
.venv/
venv/
ENV/
backend/python_portable/

# Python
__pycache__/
*.py[cod]
*$py.class
*.sqlite3

# Base de datos local (evitar subir datos reales al repo)
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# Archivos de uploads (fotos de producción)
backend/uploads/*
!backend/uploads/.gitkeep

# Certificados y claves privadas SSL
backend/certs/*.key
backend/certs/*.pem

# Frontend (Node / Vite)
node_modules/
dist/
dist-ssr/
*.local

# Logs del sistema y OS
*.log
.DS_Store
Thumbs.db
